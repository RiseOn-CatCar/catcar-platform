# ==============================================================================
# CatCar Platform - Environment Configuration Sample (.env-sample)
# ==============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env-sample .env
#
# NOTE: If you leave database passwords and JWT signing keys empty,
# scripts/bootstrap-azure.sh will automatically generate cryptographically
# secure passwords and 256-bit keys and save them to your local .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Management (APIM) Publisher Metadata
# ------------------------------------------------------------------------------
# Organization name displayed in the Azure API Management Developer Portal
APIM_PUBLISHER_NAME="CatCar Operations"

# Contact email for APIM alerts and notifications (must contain @)
APIM_PUBLISHER_EMAIL="operations@catcar.com"

# ------------------------------------------------------------------------------
# 2. Database Passwords (PostgreSQL Flexible Server 17)
# ------------------------------------------------------------------------------
# Password for the PostgreSQL server administrator login (minimum 12 characters, mixed case, numbers, symbols)
# Leave empty to auto-generate:
POSTGRES_ADMIN_PASSWORD=""

# Password for the least-privilege read-only role used by the Auth Function (minimum 12 characters)
# Leave empty to auto-generate:
POSTGRES_AUTH_READONLY_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. Cryptographic JWT Signing Keys
# ------------------------------------------------------------------------------
# HMAC-SHA256 symmetric signing key for administrative backoffice staff JWT tokens (minimum 32 characters)
# Leave empty to auto-generate a 256-bit hex key:
JWT_SECRET=""

# HMAC-SHA256 symmetric signing key for customer CPF JWT tokens issued by Auth Function and validated by APIM (minimum 32 characters)
# Leave empty to auto-generate a 256-bit hex key:
CUSTOMER_JWT_SIGNING_KEY=""

# ==============================================================================
# OPTIONAL ENVIRONMENT-SPECIFIC OVERRIDES
# ==============================================================================
# By default, the passwords and JWT keys defined above are shared between Homologation
# and Production. If you want distinct secrets per environment, set these overrides:

# --- Homologation Overrides ---
# POSTGRES_ADMIN_PASSWORD_HOMOLOG=""
# POSTGRES_AUTH_READONLY_PASSWORD_HOMOLOG=""
# JWT_SECRET_HOMOLOG=""
# CUSTOMER_JWT_SIGNING_KEY_HOMOLOG=""
# FOUNDATION_RESOURCE_GROUP_HOMOLOG="rg-catcar-homolog"
# WORKLOAD_RESOURCE_GROUP_HOMOLOG="rg-catcar-workloads-homolog"
# STATE_RESOURCE_GROUP_HOMOLOG="rg-catcar-tfstate-homolog"

# --- Production Overrides ---
# POSTGRES_ADMIN_PASSWORD_PROD=""
# POSTGRES_AUTH_READONLY_PASSWORD_PROD=""
# JWT_SECRET_PROD=""
# CUSTOMER_JWT_SIGNING_KEY_PROD=""
# FOUNDATION_RESOURCE_GROUP_PROD="CatCar"
# WORKLOAD_RESOURCE_GROUP_PROD="rg-catcar-workloads-prod"
# STATE_RESOURCE_GROUP_PROD="rg-catcar-tfstate-prod"

# ==============================================================================
# OPTIONAL PLATFORM & REPOSITORY OVERRIDES
# ==============================================================================
# Azure location/region for resource deployment (default: brazilsouth or derived from existing RG)
# AZURE_LOCATION="brazilsouth"

# GitHub Organization / Owner (default: detected from git remote origin)
# GITHUB_ORG="RiseOn-CatCar"

# Target repositories to configure with OIDC federated credentials, variables, and secrets
# REPOSITORIES="catcar-app catcar-auth-function catcar-database-infra catcar-kubernetes-infra"

# Non-user Entra ID principal running bootstrap (ServicePrincipal, Group, etc.)
# BOOTSTRAP_PRINCIPAL_OBJECT_ID=""
# BOOTSTRAP_PRINCIPAL_TYPE="User"
